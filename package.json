{
  "name": "webhybrid-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix app run dev",
    "dev:lan": "npm --prefix app run dev:lan",
    "build": "npm --prefix app run build",
    "start": "npm --prefix app run start",
    "lint": "npm --prefix app run lint",
    "tunnel": "scripts\\cloudflared.exe tunnel --url http://localhost:3000",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose restart",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose up -d --build"
  }
}
